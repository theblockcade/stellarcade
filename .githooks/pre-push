#!/bin/bash
# Pre-Push Hook for Stellarcade
# Runs strict checks on touched contracts and app surfaces before push.
# Enable this hook: git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
FAIL=0

has_npm_script() {
    local package_dir="$1"
    local script_name="$2"

    if ! command -v node >/dev/null 2>&1; then
        return 1
    fi

    (
        cd "$package_dir" &&
        node -e "const pkg=require('./package.json'); process.exit(pkg.scripts && pkg.scripts['$script_name'] ? 0 : 1)"
    )
}

echo "Running pre-push verification..."

# Normal pushes only check files touched in this push, for speed. That means
# a docs-only PR can go green locally while CI (which always lints/tests the
# WHOLE contracts workspace and web app, regardless of diff) catches
# pre-existing breakage on main that this scoped check never looked at.
# Run with STRICT_PREPUSH=1 to mirror CI exactly before opening a PR:
#   STRICT_PREPUSH=1 git push
if [ "${STRICT_PREPUSH:-}" = "1" ]; then
    echo "STRICT_PREPUSH=1 — running full CI-equivalent checks regardless of diff."
fi

CHANGED_FILES=""
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        BASE=$(git merge-base HEAD main 2>/dev/null || echo "")
        RANGE="${BASE:+$BASE..}$local_sha"
    else
        RANGE="$remote_sha..$local_sha"
    fi
    CHANGED_FILES="$CHANGED_FILES$(git diff --name-only "$RANGE" 2>/dev/null)"$'\n'
done

TOUCHED_CRATES=()
for crate_dir in "$REPO_ROOT"/contracts/*/; do
    crate=$(basename "$crate_dir")
    [ -f "$crate_dir/Cargo.toml" ] || continue
    [ -d "$crate_dir/src" ] || continue
    if echo "$CHANGED_FILES" | grep -q "^contracts/$crate/"; then
        TOUCHED_CRATES+=("$crate")
    fi
done

if command -v cargo >/dev/null 2>&1; then
    if [ "${STRICT_PREPUSH:-}" = "1" ]; then
        # Same commands CI runs: whole workspace in one shot, not a per-crate
        # loop, so nothing can be left off a hand-maintained list.
        echo "Running clippy on the entire contracts workspace (CI-equivalent)..."
        if ! (cd "$REPO_ROOT/contracts" && cargo clippy --workspace --locked -- -D warnings 2>&1); then
            echo "Workspace clippy failed."
            FAIL=1
        fi

        echo "Running tests on the entire contracts workspace (CI-equivalent)..."
        if ! (cd "$REPO_ROOT/contracts" && cargo test --workspace --locked 2>&1); then
            echo "Workspace test failed."
            FAIL=1
        fi

        if rustup target list --installed 2>/dev/null | grep -q wasm32v1-none; then
            echo "Building every contract for wasm32v1-none (CI-equivalent)..."
            if ! (cd "$REPO_ROOT/contracts" && cargo build --workspace --target wasm32v1-none --release --locked \
                --exclude stellarcade-contract-doc-generator \
                --exclude deployment-scripts 2>&1); then
                echo "Workspace wasm build failed."
                FAIL=1
            fi
        else
            echo "wasm32v1-none target not installed; skipping wasm build check."
            echo "Fix: rustup target add wasm32v1-none"
        fi
    elif [ ${#TOUCHED_CRATES[@]} -gt 0 ]; then
        echo "Strict Rust checks on: ${TOUCHED_CRATES[*]}"
        for crate in "${TOUCHED_CRATES[@]}"; do
            CRATE_DIR="$REPO_ROOT/contracts/$crate"

            echo "  -> $crate: fmt"
            if ! (cd "$CRATE_DIR" && cargo fmt -- --check 2>&1); then
                echo "fmt failed in $crate."
                echo "Fix: cd contracts/$crate && cargo fmt"
                FAIL=1
            fi

            echo "  -> $crate: clippy"
            if ! (cd "$CRATE_DIR" && cargo clippy --all-targets --all-features -- -D warnings 2>&1); then
                echo "clippy failed in $crate. Resolve warnings before pushing."
                FAIL=1
            fi

            echo "  -> $crate: test"
            if ! (cd "$CRATE_DIR" && cargo test 2>&1); then
                echo "Tests failed in $crate."
                echo "Fix: cd contracts/$crate && cargo test"
                FAIL=1
            fi
        done
    else
        echo "No contract crates changed; skipping Rust checks."
        echo "(Run with STRICT_PREPUSH=1 to check the whole workspace like CI does, regardless of what changed.)"
    fi
else
    echo "Cargo not found. Install Rust: https://rustup.rs"
fi

CONTRACTS_DOCS_CHANGED=$(echo "$CHANGED_FILES" | grep -E "^contracts/|^docs/contracts/" || true)
if [ "${STRICT_PREPUSH:-}" = "1" ] || [ -n "$CONTRACTS_DOCS_CHANGED" ]; then
    echo "Checking contract doc sync..."
    DOC_GEN_TOML="$REPO_ROOT/contracts/contract-doc-generator/Cargo.toml"
    if [ -f "$DOC_GEN_TOML" ]; then
        if ! (cd "$REPO_ROOT" && cargo run --package stellarcade-contract-doc-generator --manifest-path "$DOC_GEN_TOML" 2>&1); then
            echo "Doc generator failed."
            FAIL=1
        elif [ -n "$(git status --porcelain docs/contracts 2>/dev/null)" ]; then
            echo "Contract docs are out of sync with source."
            echo "Fix: cargo run --package stellarcade-contract-doc-generator && git add docs/contracts"
            git diff docs/contracts 2>/dev/null || true
            FAIL=1
        else
            echo "Contract doc sync OK."
        fi
    else
        echo "Doc generator not found; skipping doc sync check."
    fi
fi

BACKEND_CHANGED=$(echo "$CHANGED_FILES" | grep "^backend/" || true)
if [ "${STRICT_PREPUSH:-}" = "1" ] || [ -n "$BACKEND_CHANGED" ]; then
    echo "Verifying backend..."
    if command -v npm >/dev/null 2>&1; then
        if ! (cd "$REPO_ROOT/backend" && npm run lint 2>&1); then
            echo "Backend lint failed."
            echo "Fix: cd backend && npm run lint"
            FAIL=1
        fi

        if has_npm_script "$REPO_ROOT/backend" "openapi:validate"; then
            echo "Validating backend OpenAPI contract..."
            if ! (cd "$REPO_ROOT/backend" && npm run openapi:validate 2>&1); then
                echo "Backend OpenAPI validation failed."
                echo "Fix: cd backend && npm run openapi:validate"
                FAIL=1
            fi
        fi

        if ! (cd "$REPO_ROOT/backend" && npm test 2>&1); then
            echo "Backend tests failed."
            echo "Fix: cd backend && npm test"
            FAIL=1
        fi
    else
        echo "NPM not found. Install Node.js: https://nodejs.org"
    fi
fi

WEB_CHANGED=$(echo "$CHANGED_FILES" | grep -E "^apps/web/|^packages/tokens/" || true)
if [ "${STRICT_PREPUSH:-}" = "1" ] || [ -n "$WEB_CHANGED" ]; then
    echo "Verifying web app (apps/web)..."
    if command -v pnpm >/dev/null 2>&1; then
        if ! (cd "$REPO_ROOT" && pnpm --filter @stellarcade/web run lint 2>&1); then
            echo "Web lint failed."
            echo "Fix: pnpm --filter @stellarcade/web run lint"
            FAIL=1
        fi

        if ! (cd "$REPO_ROOT" && pnpm --filter @stellarcade/web run typecheck 2>&1); then
            echo "Web typecheck failed."
            echo "Fix: pnpm --filter @stellarcade/web run typecheck"
            FAIL=1
        fi

        if ! (cd "$REPO_ROOT" && pnpm --filter @stellarcade/web run test 2>&1); then
            echo "Web unit tests failed."
            echo "Fix: pnpm --filter @stellarcade/web run test"
            FAIL=1
        fi

        echo "(Skipping web build + Playwright e2e locally for speed; these still run in CI.)"
    else
        echo "pnpm not found. Install: npm install -g pnpm"
    fi
fi

if [ $FAIL -ne 0 ]; then
    echo ""
    echo "Pre-push checks failed; push aborted."
    exit 1
fi

echo "All checks passed. Proceeding with push."
