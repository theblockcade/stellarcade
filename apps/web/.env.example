# ==============================================================================
# Stellarcade Web Application Environment Variables (.env.example)
# ==============================================================================

# Backend REST API endpoint (Express backend or serverless route)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Stellar / Soroban Network Configuration
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban Contract Addresses (Testnet / Local)
NEXT_PUBLIC_PRIZE_POOL_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
NEXT_PUBLIC_ACHIEVEMENT_BADGE_CONTRACT_ID=CBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
NEXT_PUBLIC_ACCESS_CONTROL_CONTRACT_ID=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
NEXT_PUBLIC_COIN_FLIP_CONTRACT_ID=CDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD
NEXT_PUBLIC_RANDOM_GENERATOR_CONTRACT_ID=CEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_FAIRNESS_VERIFIER=true
