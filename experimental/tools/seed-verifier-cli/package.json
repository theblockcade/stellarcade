{
  "name": "@stellarcade/seed-verifier-cli",
  "version": "0.0.1",
  "description": "Offline provably-fair SHA-256 / HMAC-SHA256 seed and roll verification CLI for coinflip, dice, and roulette rounds",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "seed-verifier-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
